# Название приложения — отображается в заголовке Swagger UI
APP_NAME=Дневник репетитора API

# Режим отладки — показывает подробные трейсбеки в ответах. Допустимые значения: true, false
DEBUG=false

# PostgreSQL — параметры подключения к базе данных
POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
POSTGRES_DB=tutor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
